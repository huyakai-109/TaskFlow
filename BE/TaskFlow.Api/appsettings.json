{
  "ConnectionStrings": {
    "MyDatabase": "server=localhost;user id=root;password=Password@1234;database=mydb",
    "RedisDatabase": "localhost:6379",
    "QuartzDatabase": "server=localhost;port=3307;user id=root;password=Password@1234;database=quartz"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{RequestId}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Log-.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{RequestId}] [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://host.docker.internal:3100",
          "labels": [
            {
              "key": "MyProject",
              "value": "api-server"
            }
          ],
          "propertiesAsLabels": [
            "MyProject"
          ]
        }
      }
    ]
  },
  "Cors": {
    // Allow-list per environment. Empty here on purpose: startup fails rather than allowing every origin.
    "AllowedOrigins": []
  },
  "LuckyPennyLicense": "xxx",
  "ServiceName": "ApiServer",
  "EnableSwagger": true,
  "AutoMigration": true,
  "Security": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 60
    },
    "Jwt": {
      "Secret": "Ciz/K#MYpGYW56ff1E{Zy?JPvuuo)e0&-+'k)=v?%G!Mwq3vaa!!!(*x336f^^%kTj:",
      "RefreshSecret": "Qofk[eYX3QfX*sIu}e&!hy5^^&&Hw/9f4r*(#XxxxvFHH+EMEDU%n/!%agV!Lk42#~75$%^}",
      "ExpirationMinutes": 15,
      "RefreshExpirationDays": 30,
      "Issuer": "TaskFlow",
      "Audience": "localhost:5000"
    }
  },
  "StorageUrl": "http://localhost:9000/dataset/", // Bucket > Anonymous > Add prefix / with readonly access
  "MinIO": {
    "Endpoint": "host.docker.internal:9000",
    "AccessKey": "SLW7pllgjHAah15AaSpF", // Get from User > Access Keys
    "SecretKey": "PAHrki7RiRtTjnrxwLs8tNkXo2Fjn0hNjcCzcp7m",
    "Secure": false,
    "Bucket": "dataset",
    "Region": "ap-southeast-1"
  }
}
